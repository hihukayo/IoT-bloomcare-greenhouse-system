# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log

# Build artifacts and directories
**/build/
build/
*.o
*.a
*.out
*.exe # For any host-side utilities compiled on Windows

# ESP-IDF specific build outputs
*.bin
*.elf
*.map
flasher_args.json # Generated in build directory
sdkconfig.old
# NOTE: sdkconfig and dependencies.lock are tracked on purpose.
#       This is an application project: the chip target and the
#       menuconfig choices must be reproducible on a fresh clone.

# ESP-IDF dependencies
# For older versions or manual component management
/components/.idf/
**/components/.idf/
# For modern ESP-IDF component manager
managed_components/
# If ESP-IDF tools are installed/referenced locally to the project
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python environment files
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# Virtual environment folders
venv/
.venv/
env/

# Language Servers
.clangd/
.ccls-cache/
compile_commands.json

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# User-specific configuration files
*.user
*.workspace # General workspace files, can be from various tools
*.suo       # Visual Studio Solution User Options
*.sln.docstates # Visual Studio

# VS Code state that belongs to this machine and not to the project: the serial
# port of the board, and absolute paths into the local toolchain and build
# directory. Tracked, they dirty the worktree every time the board moves to
# another USB port or the extension rewrites them, and the lines are of no use
# to anyone else. launch.json stays tracked on purpose: it carries no path and
# no port, and says how to attach the debugger.
.vscode/settings.json
.vscode/c_cpp_properties.json

# Local bench credentials: a WiFi password never belongs in the repository.
# Copy main/wifi/wifi_secrets.example.h to main/wifi/wifi_secrets.h and fill it in.
main/wifi/wifi_secrets.h
